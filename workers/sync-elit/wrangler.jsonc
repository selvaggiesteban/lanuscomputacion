{
  "name": "sync-elit",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "lanus_catalog",
      "database_name": "lanus-catalog",
      "database_id": "c0a53831-2932-4dc5-94d9-b37be72e8219"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "ELIT_API_URL": "https://clientes.elit.com.ar/v1/api/productos",
    "ELIT_PAGE_LIMIT": "100"
  }
}
