# =============================================================================
# Variables de entorno — copiá este archivo a .env (local) o configure los
# secrets en Cloudflare Pages (producción). NUNCA commitees valores reales.
# =============================================================================

# --- Mercado Libre (app en https://developers.mercadolibre.com) ---
ML_CLIENT_ID=tu-valor-aquí
ML_CLIENT_SECRET=tu-valor-aquí

# --- Gmail SMTP (correo que envía notificaciones transaccionales) ---
GMAIL_USER=tu-valor-aquí
GMAIL_APP_PASSWORD=tu-valor-aquí

# --- Seguridad ---
# Secreto para invocar los endpoints cron (Bearer token)
DIGEST_TOKEN=tu-valor-aquí
# Secreto para firmar JWT de sesión
JWT_SECRET=tu-valor-aquí
# Alternativa pública del JWT (solo si aplica)
PUBLIC_JWT_SECRET=tu-valor-aquí

# --- Google OAuth (login) ---
GOOGLE_CLIENT_ID=tu-valor-aquí
GOOGLE_CLIENT_SECRET=tu-valor-aquí

# --- Mercado Pago (pagos) ---
MP_ACCESS_TOKEN=tu-valor-aquí

# --- NVIDIA (resumen con IA del digest; opcional) ---
NVIDIA_API_KEY=tu-valor-aquí

# --- R2 (backend Python: subida de imágenes de productos) ---
R2_ACCOUNT_ID=tu-valor-aquí
R2_ACCESS_KEY_ID=tu-valor-aquí
R2_SECRET_ACCESS_KEY=tu-valor-aquí
R2_BUCKET_NAME=tu-valor-aquí
R2_PUBLIC_URL=tu-valor-aquí

# NOTA: la base de datos NO es un secret — es un binding de D1 (DB) que se
# configura en wrangler.jsonc / Cloudflare Pages → Settings → Bindings.
#
# En producción: Cloudflare Pages → Settings → Environment variables (Secrets).
# En local: frontend/.env (gitignored).
