---
interface Props {
  title?: string;
}

const { title = "Lanús Computación" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Tecnología en oferta: celulares, computación, audio, gaming y más." />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-white text-ml-text antialiased">
  <header>
    <!-- El MegaMenu se integra aquí si existe -->
    <slot name="header" />
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <!-- Footer integrado -->
    <slot name="footer" />
  </footer>
</body>
</html>
