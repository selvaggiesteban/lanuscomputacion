---
import '../styles.css';

export interface Props {
  title?: string;
}

const { title = 'Iniciar sesión | Lanús Computación' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="theme-color" content="#FFE600" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="min-h-dvh bg-gray-50 text-ml-text antialiased">
    <slot />
  </body>
</html>
