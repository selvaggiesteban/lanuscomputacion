---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto - Lanús Computación',
  description: 'Contactá a Lanús Computación por WhatsApp, email o formulario. Atendemos en Lanús y zona sur de Buenos Aires.',
};
---

<BaseLayout title="Contacto | Lanús Computación" description="Contactá a Lanús Computación. WhatsApp, email, formulario de contacto y dirección. Atendemos en Lanús y zona sur de Buenos Aires.">
  <link rel="canonical" href="https://lanuscomputacion.com/contacto" slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="ml-container py-4">
    <Breadcrumb items={[
      { label: 'Inicio', href: '/' },
      { label: 'Contacto' },
    ]} />
  </div>

  <section class="ml-container pb-6">
    <div class="bg-gradient-to-r from-ml-yellow to-yellow-200 rounded-lg p-6 md:p-8">
      <h1 class="text-2xl md:text-3xl font-bold text-ml-text mb-2">Contacto</h1>
      <p class="text-ml-text-secondary text-base md:text-lg">Estamos para ayudarte. Elegí el medio que más te guste.</p>
    </div>
  </section>

  <section class="ml-container py-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <!-- WhatsApp -->
      <a href="https://wa.me/5491153323937" target="_blank" rel="noopener noreferrer" class="bg-white rounded shadow-card hover:shadow-card-hover transition-all p-6 flex flex-col items-center text-center gap-3 border border-transparent hover:border-ml-green">
        <div class="w-12 h-12 bg-ml-green-bg rounded flex items-center justify-center">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00a650" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
        </div>
        <h2 class="text-sm font-semibold text-ml-text">WhatsApp</h2>
        <p class="text-xs text-ml-text-muted">11 5332-3937</p>
        <span class="text-xs text-ml-green font-medium mt-auto">Escribir ahora →</span>
      </a>

      <!-- Email -->
      <a href="mailto:contacto@lanuscomputacion.com" class="bg-white rounded shadow-card hover:shadow-card-hover transition-all p-6 flex flex-col items-center text-center gap-3 border border-transparent hover:border-ml-blue">
        <div class="w-12 h-12 bg-ml-blue-light rounded flex items-center justify-center">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3483FA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <h2 class="text-sm font-semibold text-ml-text">Email</h2>
        <p class="text-xs text-ml-text-muted">contacto@lanuscomputacion.com</p>
        <span class="text-xs text-ml-blue font-medium mt-auto">Enviar email →</span>
      </a>

      <!-- Ubicación -->
      <div class="bg-white rounded shadow-card p-6 flex flex-col items-center text-center gap-3">
        <div class="w-12 h-12 bg-b2b-purple-light rounded flex items-center justify-center">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7C3AED" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <h2 class="text-sm font-semibold text-ml-text">Ubicación</h2>
        <p class="text-xs text-ml-text-muted">Lanús, Buenos Aires<br/>Argentina</p>
        <span class="text-xs text-ml-text-muted mt-auto">Horario: L-V 9-18hs</span>
      </div>
    </div>

    <!-- Form -->
    <div class="max-w-2xl mx-auto">
      <div class="bg-white rounded shadow-card p-6 md:p-8">
        <h2 class="text-lg font-semibold text-ml-text mb-4 text-center">Dejanos tu mensaje</h2>

        <div id="success-message" class="hidden bg-ml-green-bg text-ml-green rounded p-4 mb-4 text-sm font-medium">
          ¡Gracias! Recibimos tu mensaje. Te respondemos a la brevedad.
        </div>
        <div id="error-message" class="hidden bg-red-50 text-red-600 rounded p-4 mb-4 text-sm font-medium">
          Hubo un error al enviar. Intentá nuevamente o escribinos por WhatsApp.
        </div>

        <form id="contacto-form" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="nombre" class="block text-xs text-ml-text-muted mb-1">Nombre y apellido *</label>
              <input type="text" id="nombre" name="nombre" required class="ml-input w-full" placeholder="Tu nombre" />
            </div>
            <div>
              <label for="email" class="block text-xs text-ml-text-muted mb-1">Email *</label>
              <input type="email" id="email" name="email" required class="ml-input w-full" placeholder="tu@email.com" />
            </div>
            <div>
              <label for="telefono" class="block text-xs text-ml-text-muted mb-1">Teléfono</label>
              <input type="tel" id="telefono" name="telefono" class="ml-input w-full" placeholder="11 2345-6789" />
            </div>
            <div>
              <label for="asunto" class="block text-xs text-ml-text-muted mb-1">Asunto</label>
              <input type="text" id="asunto" name="asunto" class="ml-input w-full" placeholder="Motivo de consulta" />
            </div>
          </div>
          <div>
            <label for="mensaje" class="block text-xs text-ml-text-muted mb-1">Mensaje *</label>
            <textarea id="mensaje" name="mensaje" rows="4" required class="ml-input w-full" placeholder="Contanos en qué te podemos ayudar..."></textarea>
          </div>
          <button type="submit" class="bg-ml-blue text-white font-bold py-3 px-8 rounded w-full hover:bg-ml-blue-hover transition-colors">
            Enviar mensaje
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contacto-form') as HTMLFormElement;
  const successDiv = document.getElementById('success-message');
  const errorDiv = document.getElementById('error-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    successDiv?.classList.add('hidden');
    errorDiv?.classList.add('hidden');

    const data = new FormData(form);
    const body = {
      nombre: data.get('nombre'),
      email: data.get('email'),
      telefono: data.get('telefono'),
      servicio: data.get('asunto') || 'Contacto general',
      mensaje: data.get('mensaje'),
    };

    try {
      const res = await fetch('/api/servicios-contacto', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (res.ok) {
        successDiv?.classList.remove('hidden');
        form.reset();
      } else {
        throw new Error('Request failed');
      }
    } catch {
      errorDiv?.classList.remove('hidden');
    }
  });
</script>
