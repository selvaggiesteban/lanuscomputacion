---
// Página /ofertas: la campaña vigente con el mismo contenido que el flyer
// /lista/{año}/ofertas-lanus-{fecha}-{día}.html, renderizado desde el
// snapshot de KV (`snapshot:latest`, actualizado por lanus-flyers-updater).
// Muestra la próxima fecha de campaña (martes/viernes) a partir de hoy.
import { flyer, fechas, SITE, type FlyerSnapshot } from '../lib/flyers';

const now = new Date();
const hoy = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
const d = fechas().find((f) => f.getTime() >= hoy.getTime()) ?? hoy;

const env = (Astro.locals as any)?.runtime?.env;
const snapshot = (await env?.FLYERS?.get('snapshot:latest', 'json')) as FlyerSnapshot | null;

if (!snapshot || !Array.isArray(snapshot.secciones)) {
  return new Response('Ofertas no disponibles por el momento. Intentá más tarde.', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Retry-After': '3600' },
  });
}

return new Response(flyer(d, snapshot, { canonical: `${SITE}/ofertas` }), {
  status: 200,
  headers: {
    'Content-Type': 'text/html; charset=utf-8',
    'Cache-Control': 'public, max-age=1800',
  },
});
---
