---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/catalog/ProductGrid.astro';
import { getActivePromotions, computePromoDiscount } from '../lib/d1';

const db = Astro.locals.runtime.env.DB;

// Get active promotions
const promotions = await getActivePromotions(db);

// Get all published products with stock
const { results: allProducts } = await db.prepare(`
  SELECT * FROM products
  WHERE status = 'published' AND available_qty > 0 AND price > 0
  ORDER BY created_at DESC
`).all();

// Apply promotions to products
const offerProducts: any[] = [];
for (const product of allProducts) {
  const promo = computePromoDiscount(promotions, product.id, product.category_id, product.price);
  if (promo) {
    offerProducts.push({
      id: product.id,
      title: product.title,
      price: promo.promoPrice,
      originalPrice: product.price,
      discount: promo.discount,
      image: product.thumbnail,
      slug: product.slug,
      freeShipping: product.free_shipping === 1,
      promoName: promo.promoName,
    });
  }
}

// Sort by discount percentage (highest first)
offerProducts.sort((a, b) => b.discount - a.discount);
---

<BaseLayout title="Ofertas | Lanús Computación">
  <div class="ml-container py-4">
    <div class="bg-gradient-to-r from-red-50 to-orange-50 rounded-lg p-6 mb-6">
      <h1 class="text-2xl font-bold text-ml-text mb-1">Ofertas</h1>
      <p class="text-sm text-ml-text-secondary">Los mejores descuentos en tecnología</p>
      {promotions.length > 0 && (
        <p class="text-xs text-ml-text-muted mt-2">{promotions.length} promoción(es) activa(s)</p>
      )}
    </div>

    {offerProducts.length > 0 ? (
      <ProductGrid products={offerProducts} columns={5} />
    ) : (
      <div class="text-center py-16 text-ml-text-muted">
        <p class="text-lg">No hay ofertas disponibles</p>
        <p class="text-sm mt-1">Creá promociones en el admin para que aparezcan aquí</p>
      </div>
    )}
  </div>
</BaseLayout>
