---
import ServicePage from '../../components/servicios/ServicePage.astro';

const icon = '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>';
---

<ServicePage
  title="Mantenimiento Web en Lanús | Lanús Computación"
  description="Mantenimiento web mensual en Lanús. Actualizaciones, backups diarios, seguridad, soporte técnico y optimización. Tu web siempre online y actualizada."
  slug="mantenimiento-web"
  heroTitle="Mantenimiento Web en Lanús"
  heroSubtitle="Tu web siempre actualizada, segura y online. Backups diarios, actualizaciones, monitoreo de seguridad y soporte técnico cuando lo necesitás."
  icon={icon}
  whatsappText="Hola, quiero solicitar presupuesto de mantenimiento web"
  benefits={[
    { icon: '<path d="M21 12a9 9 0 11-6.22-8.56"/><polyline points="21 4 21 12 13 12"/>', title: 'Actualizaciones', desc: 'Mantenemos tu CMS, plugins y dependencias siempre al día.' },
    { icon: '<path d="M21 8v13H3V8M1 3h22v5H1zM10 12h4"/>', title: 'Backups diarios', desc: 'Copia de seguridad automática cada día para que no pierdas nada.' },
    { icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>', title: 'Seguridad', desc: 'Monitoreo de amenazas, firewall y protección contra malware.' },
    { icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>', title: 'Soporte técnico', desc: 'Atención por WhatsApp y email para resolver cualquier issue.' },
    { icon: '<path d="M3 3v18h18"/><path d="M7 14l4-4 4 4 6-6"/>', title: 'Reportes mensuales', desc: 'Te enviamos un informe con estado, uptime y tareas realizadas.' },
    { icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>', title: 'Optimización', desc: 'Mejoramos velocidad de carga y Core Web Vitals de Google.' },
  ]}
  steps={[
    { title: 'Diagnóstico', desc: 'Auditamos tu web: performance, seguridad, SEO y disponibilidad.' },
    { title: 'Plan', desc: 'Definimos un plan de mantenimiento mensual según tu web y necesidades.' },
    { title: 'Ejecución', desc: 'Actualizamos, hacemos backups, monitoreamos seguridad y optimizamos.' },
    { title: 'Reporte', desc: 'Te enviamos un informe mensual con las tareas realizadas y métricas.' },
  ]}
  faqs={[
    { question: '¿Qué incluye el mantenimiento web?', answer: 'Incluye actualizaciones de CMS y plugins, backups diarios, monitoreo de seguridad, optimización de velocidad, soporte técnico por WhatsApp y email, y un reporte mensual con todas las tareas realizadas.' },
    { question: '¿Hay contrato mínimo de permanencia?', answer: 'No. Trabajamos con suscripción mensual sin contrato de permanencia. Podés cancelar cuando quieras, aunque recomendamos un mínimo de 3 meses para ver resultados consistentes.' },
    { question: '¿Hacen backups de mi web?', answer: 'Sí, realizamos backups diarios automáticos. Si algo sale mal, podemos restaurar tu web a una versión anterior en minutos. Los backups se guardan en servidores independientes.' },
    { question: '¿Cuánto cuesta el mantenimiento web mensual?', answer: 'El precio depende del tipo de web (landing, blog, tienda online) y la cantidad de tareas mensuales. Te armamos un plan a medida sin costo. Solicitalo por WhatsApp.' },
    { question: '¿Qué pasa si mi web se cae?', answer: 'Si tenés el plan de mantenimiento activo, lo resolvemos sin costo adicional. Monitoreamos el uptime de tu web 24/7 y actuamos de inmediato si se cae.' },
  ]}
/>
