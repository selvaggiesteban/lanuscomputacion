  ]}
  steps={[
    { title: 'Diagnóstico', desc: 'Identificamos qué procesos se pueden automatizar y el impacto esperado.' },
    { title: 'Diseño', desc: 'Diseñamos el flujo de automatización, integraciones y lógica de IA.' },
    { title: 'Implementación', desc: 'Desarrollamos, testeamos y desplegamos la automatización.' },
