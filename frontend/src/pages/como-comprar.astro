---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

const steps = [
  { num: 1, title: 'Elegí tu producto', desc: 'Navegá por las categorías o usá el buscador para encontrar el producto que necesitás.' },
  { num: 2, title: 'Agregalo al carrito', desc: 'Hacé clic en "Agregar al carrito" y seguí navegando o pasá al checkout directamente.' },
  { num: 3, title: 'Iniciá sesión o creá una cuenta', desc: 'Si ya tenés cuenta, iniciá sesión. Si no, creá una cuenta en segundos con tu email.' },
  { num: 4, title: 'Elegí el medio de pago', desc: 'MercadoPago (tarjeta, transferencia o efectivo) o transferencia bancaria directa.' },
  { num: 5, title: 'Coordiná la entrega', desc: 'Envío a domicilio en Lanús y zona sur, o retirá en nuestro local sin costo.' },
  { num: 6, title: 'Recibí tu producto', desc: 'Te llega la confirmación por email y WhatsApp. Seguimiento de pedido en todo momento.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Cómo comprar en Lanús Computación',
  description: 'Guía paso a paso para comprar productos de tecnología en Lanús Computación.',
  step: steps.map((s) => ({
    '@type': 'HowToStep',
    position: s.num,
    name: s.title,
    text: s.desc,
  })),
};
---

<BaseLayout title="Cómo comprar | Lanús Computación" description="Guía paso a paso para comprar en Lanús Computación. Elegí, agregá al carrito, pagá con MercadoPago o transferencia y coordiná la entrega.">
  <link rel="canonical" href="https://lanuscomputacion.com/como-comprar" slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="ml-container py-4">
    <Breadcrumb items={[
      { label: 'Inicio', href: '/' },
      { label: 'Cómo comprar' },
    ]} />
  </div>

  <section class="ml-container pb-6">
    <div class="bg-gradient-to-r from-ml-yellow to-yellow-200 rounded-lg p-6 md:p-8">
      <h1 class="text-2xl md:text-3xl font-bold text-ml-text mb-2">Cómo comprar</h1>
      <p class="text-ml-text-secondary text-base md:text-lg">Comprar en Lanús Computación es fácil y seguro. Seguí estos pasos:</p>
    </div>
  </section>

  <section class="ml-container py-6 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {steps.map((step) => (
        <div class="relative bg-white rounded shadow-card p-4">
          <div class="absolute -top-3 -left-3 w-8 h-8 bg-ml-blue text-white rounded-full flex items-center justify-center text-sm font-bold">
            {step.num}
          </div>
          <h2 class="text-sm font-semibold text-ml-text mt-2">{step.title}</h2>
          <p class="text-xs text-ml-text-muted mt-1">{step.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-8 bg-ml-green-bg rounded-lg p-4 flex items-start gap-3">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00a650" stroke-width="2" stroke-linecap="round" class="flex-shrink-0 mt-0.5">
        <path d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <p class="text-sm text-ml-green">¿Tenés dudas sobre cómo comprar? Escribinos por WhatsApp al <a href="https://wa.me/5491153323937" target="_blank" rel="noopener noreferrer" class="font-semibold underline">11 5332-3937</a> y te ayudamos.</p>
    </div>
  </section>
</BaseLayout>
