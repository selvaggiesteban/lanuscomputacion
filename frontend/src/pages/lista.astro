---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fechas, partes, flyerHref } from '../lib/flyers';

const SITE = 'https://lanuscomputacion.com';
const TITLE = 'Lista de Ofertas en Tecnología | Lanús Computación';
const DESCRIPTION =
  'Ofertas de martes y viernes de Lanús Computación: seleccioná una fecha y mirá la lista completa de ofertas en tecnología con precios y stock vigentes.';

const MESES = [
  'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre',
];

const items = fechas().map((d) => {
  const { dia, fecha, iso } = partes(d);
  return { dia, fecha, iso, year: d.getUTCFullYear(), month: d.getUTCMonth(), href: flyerHref(d) };
});

const years = [...new Set(items.map((i) => i.year))];
const grupos = years.map((year) => ({
  year,
  meses: MESES.map((nombre, monthIdx) => ({
    nombre,
    items: items.filter((i) => i.year === year && i.month === monthIdx),
  })).filter((m) => m.items.length > 0),
}));
---

<BaseLayout title={TITLE} description={DESCRIPTION} image="/logo.png">
  <Fragment slot="head">
    <link rel="canonical" href={`${SITE}/lista`} />
    <meta property="og:url" content={`${SITE}/lista`} />
    <meta property="og:site_name" content="Lanús Computación" />
  </Fragment>

  <div class="ml-container max-w-2xl mx-auto py-8 px-4">
    <div class="text-center mb-8">
      <img src="/logo.png" alt="Lanús Computación" class="h-12 mx-auto mb-4" />
      <h1 class="text-2xl font-bold text-ml-text mb-2">Lista de Ofertas en Tecnología</h1>
      <p class="text-sm text-ml-text-secondary">
        Ofertas de martes y viernes. Seleccioná una fecha para ver la lista completa con precios y stock vigentes.
      </p>
    </div>

    {grupos.map((g) => (
      <section class="mb-8">
        <h2 class="text-lg font-bold text-ml-text mb-3">{g.year}</h2>
        {g.meses.map((m) => (
          <div class="mb-4">
            <h3 class="text-xs font-semibold uppercase tracking-wide text-ml-text-muted mb-2">
              {m.nombre} {g.year}
            </h3>
            <div class="space-y-2">
              {m.items.map((it) => (
                <a
                  href={it.href}
                  class="flex items-center justify-between bg-white border border-ml-border rounded-lg px-4 py-3 shadow-card hover:border-ml-blue transition-colors"
                >
                  <span class="text-sm font-medium text-ml-text">Ofertas del {it.dia} {it.fecha}</span>
                  <span class="text-xs font-semibold text-ml-blue">Ver ofertas →</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>
    ))}
  </div>
</BaseLayout>
