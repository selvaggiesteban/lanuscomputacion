---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandsSection from '../components/home/BrandsSection.astro';
import BestSellersCarousel from '../components/home/BestSellersCarousel.astro';
import { getCategories } from '../lib/d1';

const DB = Astro.locals.runtime.env.DB;
const categories = await getCategories(DB);

const categoryIds = categories.slice(0, 8).map(c => c.id);
const placeholders = categoryIds.map(() => '?').join(',');
let catImages: { category_id: string; thumbnail: string }[] = [];

if (categoryIds.length > 0) {
  try {
    const { results } = await DB.prepare(`
      SELECT category_id, thumbnail
      FROM products
      WHERE status = 'published' AND thumbnail != '' AND category_id IN (${placeholders})
      GROUP BY category_id
    `).bind(...categoryIds).all<{ category_id: string; thumbnail: string }>();
    catImages = results || [];
  } catch (e) {
    console.error("D1 Error in index.astro:", e);
    catImages = [];
  }
}
const imageMap = Object.fromEntries(catImages.map(r => [r.category_id, r.thumbnail]));

let bestSellers: any[] = [];
try {
  const toCard = (p: any) => ({
    id: p.id,
    title: p.title,
    price: p.price,
    image: p.thumbnail,
    slug: p.slug,
    categoryName: p.category_name,
    freeShipping: p.free_shipping === 1,
    dollarRate: p.dollar_rate,
    ivaPct: p.iva_pct,
    internalTaxPct: p.internal_tax_pct,
    availableQty: p.available_qty,
  });

  // Carrusel "Más vendidos": 5 cámaras de seguridad, 5 monitores, 5
  // notebooks y 5 routers WiFi (por sold_qty); si un grupo no alcanza,
  // se rellena con los más vendidos generales que falten.
  const groups: { where: string }[] = [
    { where: "category_name = 'Seguridad'" },
    { where: "title LIKE '%Monitor%'" },
    { where: "title LIKE '%Notebook%'" },
    { where: "title LIKE '%Router%'" },
  ];
  const selected = new Map<string, any>();
  for (const g of groups) {
    const { results } = await DB.prepare(`
      SELECT id, title, price, thumbnail, slug, category_name, available_qty,
             dollar_rate, free_shipping, iva_pct, internal_tax_pct, sold_qty
      FROM products
      WHERE status = 'published' AND available_qty > 0 AND price > 0
        AND (${g.where})
      ORDER BY sold_qty DESC, created_at DESC
      LIMIT 5
    `).all();
    for (const p of results || []) selected.set(String(p.id), p);
  }
  if (selected.size < 20) {
    const { results } = await DB.prepare(`
      SELECT id, title, price, thumbnail, slug, category_name, available_qty,
             dollar_rate, free_shipping, iva_pct, internal_tax_pct, sold_qty
      FROM products
      WHERE status = 'published' AND available_qty > 0 AND price > 0
      ORDER BY sold_qty DESC, created_at DESC
      LIMIT 60
    `).all();
    for (const p of results || []) {
      if (selected.size >= 20) break;
      if (!selected.has(String(p.id))) selected.set(String(p.id), p);
    }
  }
  bestSellers = [...selected.values()].map(toCard);
} catch (e) {
  console.error("D1 Error bestSellers in index.astro:", e);
  bestSellers = [];
}

const staticSlideImages: Record<string, { src: string; alt: string }> = {
  cat_celulares: {
    src: '/2601_image_41341.webp',
    alt: 'Celulares y teléfonos: smartphones, accesorios y repuestos en Lanús Computación',
  },
};
---

<BaseLayout title="Lanús Computación - Tecnología en oferta">
  <!-- Hero Banner -->
  <section class="bg-white">
    <div class="ml-container py-8 md:py-12">
      <div class="max-w-2xl">
        <h1 class="text-3xl md:text-4xl font-bold text-ml-text mb-3">
          Tecnología en oferta
        </h1>
        <p class="text-lg text-ml-text-secondary mb-6">
          Encontrá todo en celulares, computación, audio, gaming y más.
        </p>
        <div class="flex gap-3">
          <a href="/categoria/todas" class="ml-btn-primary bg-black hover:bg-gray-800">
            Ver productos
          </a>
          <a href="/ofertas" class="ml-btn-secondary bg-white text-black border border-black hover:bg-gray-100">
            Ofertas
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="ml-container py-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-lg p-4 flex items-center gap-3 border border-ml-border">
        <div class="w-10 h-10 bg-[#f1f1f1] rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 12l2 2 4-4"/>
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-ml-text">Garantía oficial</h4>
          <p class="text-xs text-ml-text-muted">Directa de marca</p>
        </div>
      </div>
      <div class="bg-white rounded-lg p-4 flex items-center gap-3 border border-ml-border">
        <div class="w-10 h-10 bg-[#f1f1f1] rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
            <line x1="1" y1="10" x2="23" y2="10"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-ml-text">Hasta 12 cuotas</h4>
          <p class="text-xs text-ml-text-muted">Con todas las tarjetas</p>
        </div>
      </div>
      <div class="bg-white rounded-lg p-4 flex items-center gap-3 border border-ml-border">
        <div class="w-10 h-10 bg-[#f1f1f1] rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"/>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
            <circle cx="5.5" cy="18.5" r="2.5"/>
            <circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-ml-text">Envío 24/48h</h4>
          <p class="text-xs text-ml-text-muted">A todo el país</p>
        </div>
      </div>
      <div class="bg-white rounded-lg p-4 flex items-center gap-3 border border-ml-border">
        <div class="w-10 h-10 bg-[#f1f1f1] rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-ml-text">Soporte experto</h4>
          <p class="text-xs text-ml-text-muted">Asesoría real</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Más Vendidos -->
  {bestSellers.length >= 2 && <BestSellersCarousel products={bestSellers} />}

  <!-- Categorías -->
  <section class="ml-container py-8">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-semibold text-ml-text">Categorías</h2>
      <a href="/categoria/todas" class="text-sm ml-link">Ver todas</a>
    </div>

    <div class="relative">
      <div class="overflow-hidden rounded-lg border border-ml-border bg-white shadow-card">
        <div id="cat-track" class="flex transition-transform duration-500 ease-out">
          {categories.slice(0, 8).map((cat) => {
            const slideImage = staticSlideImages[cat.id];
            const imgSrc = slideImage?.src ?? imageMap[cat.id];
            const imgAlt = slideImage?.alt ?? cat.name;
            return (
            <a href={`/categoria/${cat.slug}`} class="min-w-full">
              <div class="flex flex-col md:flex-row items-center">
                <div class="w-full md:w-1/2 p-6 md:p-10 md:pl-14 text-center md:text-left">
                  <h2 class="text-xl md:text-3xl font-bold text-ml-text">{cat.name}</h2>
                </div>
                <div class="w-full md:w-1/2 p-6 md:p-8 flex items-center justify-center">
                  {imgSrc ? (
                    <img src={imgSrc} alt={imgAlt} class="h-40 md:h-56 object-contain" loading="lazy" />
                  ) : (
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-32 h-32 text-gray-300">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <path d="M21 15l-5-5L5 21"/>
                    </svg>
                  )}
                </div>
              </div>
            </a>
            );
          })}
        </div>
      </div>

      <button id="cat-prev" type="button" aria-label="Anterior" class="absolute left-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/95 border border-ml-border shadow-card flex items-center justify-center text-ml-text hover:bg-gray-50 transition-colors z-10">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button id="cat-next" type="button" aria-label="Siguiente" class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/95 border border-ml-border shadow-card flex items-center justify-center text-ml-text hover:bg-gray-50 transition-colors z-10">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <div id="cat-dots" class="flex justify-center gap-2 mt-4">
        {categories.slice(0, 8).map((cat, i) => (
          <button type="button" aria-label={`Ir a ${cat.name}`} class={`w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-ml-text' : 'bg-gray-300'}`}></button>
        ))}
      </div>
    </div>

    <script>
      const track = document.getElementById('cat-track') as HTMLDivElement | null;
      const prev = document.getElementById('cat-prev') as HTMLButtonElement | null;
      const next = document.getElementById('cat-next') as HTMLButtonElement | null;
      const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('#cat-dots button'));

      if (track && prev && next && dots.length > 0) {
        let idx = 0;
        const go = (i: number) => {
          idx = (i + dots.length) % dots.length;
          track.style.transform = `translateX(-${idx * 100}%)`;
          dots.forEach((d, k) => {
            d.classList.toggle('bg-ml-text', k === idx);
            d.classList.toggle('bg-gray-300', k !== idx);
          });
        };
        prev.addEventListener('click', () => go(idx - 1));
        next.addEventListener('click', () => go(idx + 1));
        dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
      }
    </script>
  </section>

  <!-- Marcas -->
  <BrandsSection />

  <!-- Popup 404 -->
  <div id="not-found-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4">
    <div class="bg-white rounded-xl shadow-card p-6 max-w-sm w-full text-center">
      <div class="text-5xl font-bold text-ml-yellow mb-3">!</div>
      <h2 class="text-xl font-bold text-ml-text mb-2">Página no encontrada</h2>
      <p class="text-ml-text-secondary mb-5">La página que buscas no existe o fue movida.</p>
      <button id="not-found-close" type="button" class="ml-btn-primary">Volver al inicio</button>
    </div>
  </div>

  <script>
    const nfModal = document.getElementById('not-found-modal');
    const nfClose = document.getElementById('not-found-close');

    const showNf = () => {
      if (!nfModal) return;
      if (window.location.hash === '#404') {
        nfModal.classList.remove('hidden');
        nfModal.classList.add('flex');
      } else {
        nfModal.classList.add('hidden');
        nfModal.classList.remove('flex');
      }
    };

    const hideNf = () => {
      nfModal?.classList.add('hidden');
      nfModal?.classList.remove('flex');
      history.replaceState(null, '', window.location.pathname + window.location.search);
      window.scrollTo({ top: 0 });
    };

    showNf();
    window.addEventListener('hashchange', showNf);
    nfClose?.addEventListener('click', hideNf);
    nfModal?.addEventListener('click', (e) => {
      if (e.target === nfModal) hideNf();
    });
  </script>
</BaseLayout>
