---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/catalog/ProductGrid.astro';
import BrandsSection from '../components/home/BrandsSection.astro';
import { getProducts, getCategories } from '../lib/d1';

const db = Astro.locals.runtime.env.DB;
const featuredProducts = await getProducts(db, { limit: 10 });
const categories = await getCategories(db);

const categoryIds = categories.slice(0, 8).map(c => `'${c.id}'`).join(',');
const { results: catImages } = await db.prepare(`
  SELECT category_id, thumbnail
  FROM products
  WHERE status = 'published' AND thumbnail != '' AND category_id IN (${categoryIds})
  GROUP BY category_id
`).all<{ category_id: string; thumbnail: string }>();
const imageMap = Object.fromEntries(catImages.map(r => [r.category_id, r.thumbnail]));
---

<BaseLayout title="Lanús Computación - Tecnología al mejor precio">
  <!-- Hero Banner -->
  <section class="bg-gradient-to-r from-ml-yellow to-yellow-200">
    <div class="ml-container py-8 md:py-12">
      <div class="max-w-2xl">
        <h1 class="text-3xl md:text-4xl font-bold text-ml-text mb-3">
          Tecnología al mejor precio
        </h1>
        <p class="text-lg text-ml-text-secondary mb-6">
          Encontrá todo en celulares, computación, audio, gaming y más. 
          <span class="text-b2b-purple font-semibold">Precios especiales para empresas.</span>
        </p>
        <div class="flex gap-3">
          <a href="/categoria/todas" class="ml-btn-primary">
            Ver catálogo
          </a>
          <a href="/ofertas" class="ml-btn-secondary">
            Ofertas
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="ml-container py-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-lg p-4 flex items-center gap-3 border border-ml-border">
        <div class="w-10 h-10 bg-ml-green-bg rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-ml-green" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 12l2 2 4-4"/>
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-ml-text">Garantía oficial</h4>
          <p class="text-xs text-ml-text-muted">Directa de marca</p>
        </div>
      </div>
      <div class="bg-white rounded-lg p-4 flex items-center gap-3 border border-ml-border">
        <div class="w-10 h-10 bg-ml-blue-light rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-ml-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
            <line x1="1" y1="10" x2="23" y2="10"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-ml-text">Hasta 12 cuotas</h4>
          <p class="text-xs text-ml-text-muted">Con todas las tarjetas</p>
        </div>
      </div>
      <div class="bg-white rounded-lg p-4 flex items-center gap-3 border border-ml-border">
        <div class="w-10 h-10 bg-ml-green-bg rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-ml-green" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"/>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
            <circle cx="5.5" cy="18.5" r="2.5"/>
            <circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-ml-text">Envío 24/48h</h4>
          <p class="text-xs text-ml-text-muted">A todo el país</p>
        </div>
      </div>
      <div class="bg-white rounded-lg p-4 flex items-center gap-3 border border-ml-border">
        <div class="w-10 h-10 bg-ml-yellow rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-ml-text" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-ml-text">Soporte experto</h4>
          <p class="text-xs text-ml-text-muted">Asesoría real</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Productos destacados -->
  <section class="ml-container py-8">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-semibold text-ml-text">Productos destacados</h2>
      <a href="/categoria/todas" class="text-sm ml-link">Ver más</a>
    </div>
    <ProductGrid products={featuredProducts.map(p => ({
      id: p.id,
      title: p.title,
      price: p.price,
      image: p.thumbnail,
      slug: p.slug,
      freeShipping: false,
      dollarRate: p.dollar_rate,
    }))} columns={5} />
  </section>

  <!-- Categorías -->
  <section class="ml-container py-8">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-semibold text-ml-text">Categorías</h2>
      <a href="/categoria/todas" class="text-sm ml-link">Ver todas</a>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {categories.slice(0, 8).map((cat) => (
        <a
          href={`/categoria/${cat.slug}`}
          class="ml-card p-4 flex items-center gap-3 hover:border-ml-blue hover:shadow-card-hover transition-all"
        >
          <div class="w-14 h-14 bg-ml-bg rounded flex items-center justify-center flex-shrink-0 overflow-hidden">
            {imageMap[cat.id] ? (
              <img src={imageMap[cat.id]} alt={cat.name} class="w-full h-full object-contain" loading="lazy" />
            ) : (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            )}
          </div>
          <div>
            <h3 class="text-sm font-medium text-ml-text">{cat.name}</h3>
            {cat.total_items > 0 && (
              <p class="text-xs text-ml-text-muted">{cat.total_items} productos</p>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Marcas -->
  <BrandsSection />
</BaseLayout>
