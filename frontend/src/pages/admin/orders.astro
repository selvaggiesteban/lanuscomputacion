---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getEmailLog } from '../../lib/emaillog';

const DB = Astro.locals.runtime.env.DB;
const page = Number(Astro.url.searchParams.get('page') || 1);
const status = Astro.url.searchParams.get('status') || '';
const limit = 20;
const offset = (page - 1) * limit;

let orders: any[] = [];
let total = 0;

if (status) {
    try {
      const { results } = await DB.prepare("SELECT * FROM orders WHERE status = ? ORDER BY created_at DESC LIMIT ? OFFSET ?").bind(status, limit, offset).all();
      orders = results;
      const countResult = await DB.prepare("SELECT COUNT(*) as count FROM orders WHERE status = ?").bind(status).first<{ count: number }>();
      total = countResult?.count ?? 0;
    } catch (e) {
      console.error("Error fetching filtered orders:", e);
      orders = [];
      total = 0;
    }
  } else {
    try {
      const { results } = await DB.prepare("SELECT * FROM orders ORDER BY created_at DESC LIMIT ? OFFSET ?").bind(limit, offset).all();
      orders = results;
      const countResult = await DB.prepare("SELECT COUNT(*) as count FROM orders").first<{ count: number }>();
      total = countResult?.count ?? 0;
    } catch (e) {
      console.error("Error fetching all orders:", e);
      orders = [];
      total = 0;
    }
  }

const totalPages = Math.ceil(total / limit);

let postventa: Record<string, { status: string; sent_at: string | null }> = {};
let emailLog: Record<string, Record<string, string>> = {};
if (orders.length > 0) {
  const ids = orders.map((o: any) => o.id);
  try {
    const placeholders = ids.map(() => '?').join(',');
    const rows = await DB.prepare(
      `SELECT order_id, status, sent_at FROM postventa_emails WHERE order_id IN (${placeholders})`
    ).bind(...ids).all<{ order_id: string; status: string; sent_at: string | null }>();
    for (const r of rows.results || []) postventa[r.order_id] = { status: r.status, sent_at: r.sent_at };
  } catch (e) {
    console.error("Error fetching postventa emails:", e);
  }
  emailLog = await getEmailLog(DB, ids);
}

let productTitles: Record<string, string> = {};
if (orders.length > 0) {
  try {
    const ids = orders.map((o: any) => o.id);
    const placeholders = ids.map(() => '?').join(',');
    const items = await DB.prepare(
      `SELECT order_id, product_title, quantity FROM order_items WHERE order_id IN (${placeholders})`
    ).bind(...ids).all<{ order_id: string; product_title: string; quantity: number }>();
    for (const it of items.results || []) {
      const label = `${it.product_title}${it.quantity > 1 ? ` x${it.quantity}` : ''}`;
      productTitles[it.order_id] = productTitles[it.order_id] ? `${productTitles[it.order_id]}, ${label}` : label;
    }
    const legacy = orders.filter((o: any) => o.product_id && !productTitles[o.id]);
    if (legacy.length > 0) {
      const pids = legacy.map((o: any) => o.product_id);
      const ph2 = pids.map(() => '?').join(',');
      const prods = await DB.prepare(
        `SELECT id, title FROM products WHERE id IN (${ph2})`
      ).bind(...pids).all<{ id: string; title: string }>();
      const byId: Record<string, string> = Object.fromEntries((prods.results || []).map((p) => [p.id, p.title]));
      for (const o of legacy) {
        productTitles[o.id] = byId[o.product_id] || '—';
      }
    }
  } catch (e) {
    console.error("Error fetching order items:", e);
  }
}

const statusLabels: Record<string, string> = {
  pending: 'Pendiente', paid: 'Pagado', processing: 'Procesando',
  shipped: 'Enviado', delivered: 'Entregado', cancelled: 'Cancelado',
};
const statusColors: Record<string, string> = {
  pending: 'bg-yellow-100 text-yellow-800', paid: 'bg-green-100 text-green-800',
  processing: 'bg-blue-100 text-blue-800', shipped: 'bg-purple-100 text-purple-800',
  delivered: 'bg-green-100 text-green-800', cancelled: 'bg-red-100 text-red-800',
};

const emailTemplates = ['confirmation', 'status_update', 'postventa'];

const fmtSentDate = (ts: string | null | undefined): string =>
  ts ? new Date(ts.replace(' ', 'T') + 'Z').toLocaleDateString('es-AR') : '';

const emailState = (o: any, tpl: string): { sent: boolean; at: string } => {
  if (tpl === 'postventa') {
    const pv = postventa[o.id];
    return pv?.status === 'sent' ? { sent: true, at: fmtSentDate(pv.sent_at) } : { sent: false, at: '' };
  }
  const at = emailLog[o.id]?.[tpl];
  return at ? { sent: true, at: fmtSentDate(at) } : { sent: false, at: '' };
};

const sentCount = (o: any): number => emailTemplates.filter((t) => emailState(o, t).sent).length;

const templateLabels = (o: any): { tpl: string; label: string }[] => [
  { tpl: 'confirmation', label: 'Confirmación de pedido' },
  { tpl: 'status_update', label: `Actualización · ${statusLabels[o.status] || o.status}` },
  { tpl: 'postventa', label: 'Postventa (recomendación)' },
];
---

<AdminLayout title="Órdenes | Admin - Lanús Computación">
  <div class="ml-container py-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-semibold text-ml-text">Órdenes</h1>
      <a href="/admin" class="text-sm text-ml-blue hover:underline">← Volver</a>
    </div>

    <div class="bg-white rounded shadow-card p-4 mb-6">
      <div class="flex gap-3 flex-wrap">
        <a href="/admin/orders" class={`px-3 py-1 rounded text-sm ${!status ? 'bg-ml-blue text-white' : 'bg-gray-100 hover:bg-gray-200'}`}>Todas</a>
        {Object.entries(statusLabels).map(([key, label]) => (
          <a href={`/admin/orders?status=${key}`} class={`px-3 py-1 rounded text-sm ${status === key ? 'bg-ml-blue text-white' : 'bg-gray-100 hover:bg-gray-200'}`}>{label}</a>
        ))}
      </div>
    </div>

    <div class="bg-white rounded shadow-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 border-b">
            <tr>
              <th class="text-left p-3 font-medium text-ml-text">Pedido</th>
              <th class="text-left p-3 font-medium text-ml-text">Cliente</th>
              <th class="text-left p-3 font-medium text-ml-text">Producto</th>
              <th class="text-right p-3 font-medium text-ml-text">Total</th>
              <th class="text-center p-3 font-medium text-ml-text">Estado</th>
              <th class="text-left p-3 font-medium text-ml-text">Fecha</th>
              <th class="text-center p-3 font-medium text-ml-text">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y">
            {(orders || []).map((o: any) => (
              <tr class="hover:bg-gray-50">
                <td class="p-3 font-mono text-xs text-ml-text">#{o.id.slice(0, 8)}...</td>
                <td class="p-3">
                  <p class="text-ml-text">{o.customer_name}</p>
                  <p class="text-xs text-ml-text-muted">{o.customer_email}</p>
                  {o.address && <p class="text-xs text-ml-text-muted">{o.address}</p>}
                </td>
                <td class="p-3 text-ml-text-muted text-xs max-w-xs">
                  <span class="line-clamp-2">{productTitles[o.id] || '—'}</span>
                </td>
                <td class="p-3 text-right font-medium text-ml-text">
            ${o.total_price?.toLocaleString('es-AR')}
            {o.shipping_cost > 0 && <span class="block text-xs text-ml-text-muted font-normal">incl. envío ${o.shipping_cost.toLocaleString('es-AR')}</span>}
          </td>
                <td class="p-3 text-center">
                  <select class={`status-select text-xs font-medium rounded px-2 py-1 border-0 ${statusColors[o.status] || 'bg-gray-100'}`} data-id={o.id}>
                    {Object.entries(statusLabels).map(([key, label]) => (
                      <option value={key} selected={o.status === key}>{label}</option>
                    ))}
                  </select>
                </td>
                <td class="p-3 text-ml-text-muted text-xs">{new Date(o.created_at).toLocaleDateString('es-AR')}</td>
                <td class="p-3 text-center text-xs">
                  <a href={`/compras?order=${o.id}`} class="text-ml-blue hover:underline">Ver</a>
                  <div class="relative mt-1 inline-block" data-email-dd data-order-id={o.id}>
                    <button
                      type="button"
                      data-email-toggle
                      class="px-2 py-1 border border-ml-border rounded bg-white text-ml-text-secondary hover:bg-gray-50 text-[11px] font-medium cursor-pointer"
                    >
                      Emails ▾ ({sentCount(o)}/3)
                    </button>
                    <div
                      data-email-menu
                      class="hidden fixed w-64 bg-white border border-ml-border rounded-lg shadow-lg divide-y divide-gray-100 text-left"
                    >
                      {templateLabels(o).map(({ tpl, label }) => {
                        const st = emailState(o, tpl);
                        return (
                          <button
                            type="button"
                            data-email-send={tpl}
                            data-sent={st.sent ? '1' : '0'}
                            class="w-full px-3 py-2 flex items-center justify-between gap-3 hover:bg-gray-50 disabled:opacity-50 text-left cursor-pointer"
                          >
                            <span class="text-ml-text">{label}</span>
                            <span class={`text-[10px] font-semibold whitespace-nowrap ${st.sent ? 'text-green-700' : 'text-yellow-700'}`}>
                              {st.sent ? `Enviado ✓ ${st.at}` : 'Pendiente'}
                            </span>
                          </button>
                        );
                      })}
                    </div>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {totalPages > 1 && (
        <div class="p-4 border-t flex items-center justify-between">
          <p class="text-sm text-ml-text-muted">Mostrando {offset + 1}-{Math.min(offset + limit, total)} de {total}</p>
          <div class="flex gap-2">
            {page > 1 && <a href={`/admin/orders?page=${page - 1}${status ? `&status=${status}` : ''}`} class="px-3 py-1 border rounded text-sm hover:bg-gray-50">Anterior</a>}
            {page < totalPages && <a href={`/admin/orders?page=${page + 1}${status ? `&status=${status}` : ''}`} class="px-3 py-1 border rounded text-sm hover:bg-gray-50">Siguiente</a>}
          </div>
        </div>
      )}
    </div>
  </div>
</AdminLayout>

<script>
  document.querySelectorAll('.status-select').forEach(select => {
    select.addEventListener('change', async (e) => {
      const id = (e.target as HTMLElement).dataset.id;
      const status = (e.target as HTMLSelectElement).value;
      await fetch('/api/admin/orders', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, status }),
      });
      location.reload();
    });
  });

  function closeEmailMenus(except?: HTMLElement) {
    document.querySelectorAll<HTMLElement>('[data-email-menu]').forEach((m) => {
      if (m !== except) m.classList.add('hidden');
    });
  }

  document.querySelectorAll<HTMLElement>('[data-email-dd]').forEach((dd) => {
    const toggle = dd.querySelector<HTMLButtonElement>('[data-email-toggle]');
    const menu = dd.querySelector<HTMLElement>('[data-email-menu]');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const opening = menu.classList.contains('hidden');
      closeEmailMenus();
      if (!opening) return;
      const r = toggle.getBoundingClientRect();
      const menuH = menu.scrollHeight || 150;
      menu.style.position = 'fixed';
      menu.style.zIndex = '40';
      menu.style.width = '16rem';
      if (r.bottom + menuH + 8 > window.innerHeight && r.top - menuH - 8 > 0) {
        menu.style.top = '';
        menu.style.bottom = `${window.innerHeight - r.top + 8}px`;
      } else {
        menu.style.bottom = '';
        menu.style.top = `${r.bottom + 8}px`;
      }
      menu.style.right = `${Math.max(8, window.innerWidth - r.right)}px`;
      menu.classList.remove('hidden');
    });

    dd.querySelectorAll<HTMLElement>('[data-email-send]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const orderId = dd.dataset.orderId;
        const tpl = btn.dataset.emailSend;
        if (!orderId || !tpl) return;
        if (btn.dataset.sent === '1' && !window.confirm('Este email ya fue enviado. ¿Reenviarlo?')) return;
        const b = btn as HTMLButtonElement;
        b.disabled = true;
        try {
          const res = await fetch('/api/admin/emails', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ order_id: orderId, template: tpl }),
          });
          const data = await res.json().catch(() => ({} as any));
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            b.disabled = false;
            window.alert(data.error || 'No se pudo enviar el email');
          }
        } catch {
          b.disabled = false;
          window.alert('Error de red al enviar el email');
        }
      });
    });
  });

  document.addEventListener('click', () => closeEmailMenus());
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeEmailMenus();
  });
</script>
