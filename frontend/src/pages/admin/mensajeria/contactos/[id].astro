---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getContacts, upsertContact, deleteContact } from '../../../../lib/d1';

const { id } = Astro.params;
const db = Astro.locals.runtime.env.DB;

let contact = null;
if (id) {
  contact = await getContactById(db, Number(id));
  if (!contact) {
    return Astro.redirect('/admin/mensajeria/contactos');
  }
}
---

<BaseLayout title={contact ? `Editar Contacto: ${contact.name}` : 'Nuevo Contacto' | Lanús Computación}>
  <div class="ml-container py-6">
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-xl font-semibold text-ml-text">{contact ? 'Editar' : 'Nuevo'} Contacto</h1>
        </div>
        <a href="/admin/mensajeria/contactos" class="text-sm ml-link">← Volver</a>
      </div>

      <form id="contact-form" class="bg-white rounded shadow-card p-6 space-y-6">
        {contact && <input type="hidden" name="id" value="{contact.id}" />}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Nombre *</label>
            <input type="text" name="name" value="{contact?.name || ''}" class="ml-input w-full" required />
          </div>
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Email</label>
            <input type="email" name="email" value="{contact?.email || ''}" class="ml-input w-full" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Teléfono</label>
            <input type="tel" name="phone" value="{contact?.phone || ''}" class="ml-input w-full" placeholder="+54 11 1234-5678" />
          </div>
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">WhatsApp</label>
            <input type="tel" name="whatsapp" value="{contact?.whatsapp || ''}" class="ml-input w-full" placeholder="5491153323937" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Telegram</label>
            <input type="text" name="telegram" value="{contact?.telegram || ''}" class="ml-input w-full" placeholder="@usuario" />
          </div>
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Messenger ID</label>
            <input type="text" name="messenger_id" value="{contact?.messenger_id || ''}" class="ml-input w-full" />
          </div>
        </div>

        <div>
          <label class="block text-xs text-ml-text-muted mb-1">Etiquetas (JSON array)</label>
          <input type="text" name="tags" value="{contact?.tags || '[]'}" class="ml-input w-full" placeholder='["cliente", "vip", "b2b"]' />
        </div>

        <div>
          <label class="block text-xs text-ml-text-muted mb-1">Notas</label>
          <textarea name="notes" class="ml-input w-full" rows="3" placeholder="Notas internas...">{contact?.notes || ''}</textarea>
        </div>

        <div class="flex items-center gap-2">
          <input type="checkbox" name="is_subscribed" class="w-4 h-4 text-ml-yellow rounded" checked={!contact || contact.is_subscribed} />
          <span class="text-sm text-ml-text">Suscrito a comunicaciones (SMS/Email)</span>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t">
          <a href="/admin/mensajeria/contactos" class="ml-btn-outline">Cancelar</a>
          <button type="submit" class="ml-btn-primary">{contact ? 'Guardar' : 'Crear'}</button>
        </div>
      </form>

      {contact && (
        <div class="mt-4 text-center">
          <button onclick="deleteContact('{contact.id}')" class="text-red-600 hover:underline text-sm">Eliminar contacto</button>
        </div>
      )}
    </div>
  </div>

  <script>
    document.getElementById('contact-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      data.is_subscribed = data.is_subscribed ? 1 : 0;
      if (data.id) data.id = Number(data.id);
      try {
        data.tags = JSON.parse(formData.get('tags') || '[]');
      } catch {
        data.tags = [];
      }

      try {
        const res = await fetch('/api/admin/mensajeria/contactos', {
          method: contact ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) {
          alert(contact ? 'Guardado correctamente' : 'Contacto creado');
          location.href = '/admin/mensajeria/contactos';
        } else {
          alert('Error al guardar');
        }
      } catch {
        alert('Error de conexión');
      }
    });

    async function deleteContact(id) {
      if (!confirm('¿Eliminar este contacto?')) return;
      try {
        const res = await fetch('/api/admin/mensajeria/contactos', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id })
        });
        if (res.ok) {
          location.href = '/admin/mensajeria/contactos';
        } else {
          alert('Error al eliminar');
        }
      } catch {
        alert('Error de conexión');
      }
    }
  </script>
</BaseLayout>