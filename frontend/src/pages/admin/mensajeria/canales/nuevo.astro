---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getAllMessagingChannels, upsertMessagingChannel } from '../../../../lib/d1';

const db = Astro.locals.runtime.env.DB;
const channels = await getAllMessagingChannels(db);
---

<BaseLayout title="Nuevo Canal de Mensajería | Lanús Computación">
  <div class="ml-container py-6">
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-xl font-semibold text-ml-text">Nuevo Canal de Mensajería</h1>
        </div>
        <a href="/admin/mensajeria" class="text-sm ml-link">← Volver</a>
      </div>

      <form id="channel-form" class="bg-white rounded shadow-card p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">ID (slug único)</label>
            <input type="text" name="id" class="ml-input w-full" required placeholder="whatsapp, telegram, email, sms, custom" pattern="[a-z_]+" />
          </div>
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Nombre</label>
            <input type="text" name="name" class="ml-input w-full" required placeholder="WhatsApp, Telegram, Email, SMS" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Icono (emoji)</label>
            <input type="text" name="icon" class="ml-input w-full" maxlength="2" placeholder="💬" />
          </div>
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Orden de visualización</label>
            <input type="number" name="display_order" value="{channels.length}" class="ml-input w-full" min="0" />
          </div>
        </div>

        <div class="flex items-end">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="is_active" class="w-4 h-4 text-ml-yellow rounded" checked />
            <span class="text-sm text-ml-text">Activo</span>
          </label>
        </div>

        <div>
          <label class="block text-xs text-ml-text-muted mb-1">Configuración (JSON)</label>
          <textarea name="config" class="ml-input w-full font-mono text-sm" rows="8" placeholder='{"phone": "5491153323937", "default_message": "Hola, me interesa..."}'>{JSON.stringify({}, null, 2)}</textarea>
          <p class="text-xs text-ml-text-muted mt-1">Ejemplos: WhatsApp: {"phone": "5491153323937", "default_message": "..."}, Email: {"address": "info@...", "smtp_host": "...", "smtp_port": 587, "smtp_user": "...", "smtp_pass": "..."}</p>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t">
          <a href="/admin/mensajeria" class="ml-btn-outline">Cancelar</a>
          <button type="submit" class="ml-btn-primary">Crear canal</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    document.getElementById('channel-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      data.is_active = data.is_active ? 1 : 0;
      data.display_order = Number(data.display_order);
      try {
        data.config = JSON.parse(formData.get('config') || '{}');
      } catch {
        alert('JSON inválido en configuración');
        return;
      }

      try {
        const res = await fetch('/api/admin/mensajeria/canales', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) {
          alert('Canal creado correctamente');
          location.href = '/admin/mensajeria';
        } else {
          const err = await res.json();
          alert('Error: ' + (err.error || 'Error al crear'));
        }
      } catch {
        alert('Error de conexión');
      }
    });
  </script>
</BaseLayout>