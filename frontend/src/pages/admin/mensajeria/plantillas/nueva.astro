---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { upsertMessageTemplate } from '../../../../lib/d1';
---

<BaseLayout title="Nueva Plantilla | Lanús Computación">
  <div class="ml-container py-6">
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-xl font-semibold text-ml-text">Nueva Plantilla</h1>
        <a href="/admin/mensajeria/plantillas" class="text-sm ml-link">← Volver</a>
      </div>

      <form id="template-form" class="bg-white rounded shadow-card p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">ID (slug único)</label>
            <input type="text" name="id" class="ml-input w-full" required pattern="[a-z_]+" placeholder="ej: bienvenida_whatsapp" />
          </div>
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Nombre</label>
            <input type="text" name="name" class="ml-input w-full" required placeholder="Bienvenida WhatsApp" />
          </div>
        </div>

        <div>
          <label class="block text-xs text-ml-text-muted mb-1">Canal</label>
          <select name="channel_id" class="ml-input w-full" required>
            <option value="whatsapp">WhatsApp</option>
            <option value="telegram">Telegram</option>
            <option value="messenger">Messenger</option>
            <option value="email">Email</option>
            <option value="sms">SMS</option>
          </select>
        </div>

        <div>
          <label class="block text-xs text-ml-text-muted mb-1">Asunto (solo email)</label>
          <input type="text" name="subject" class="ml-input w-full" placeholder="Asunto del email" />
        </div>

        <div>
          <label class="block text-xs text-ml-text-muted mb-1">Contenido *</label>
          <textarea name="content" class="ml-input w-full font-mono text-sm" rows="8" required placeholder="Hola {{name}}, bienvenido a {{company}}..."></textarea>
          <p class="text-xs text-ml-text-muted mt-1">Variables: {{name}}, {{company}}, {{order_id}}, {{total}}, {{product}}, {{discount}}, {{url}}, {{message}}, {{details}}</p>
        </div>

        <div>
          <label class="block text-xs text-ml-text-muted mb-1">Variables (JSON array)</label>
          <input type="text" name="variables" value="[]" class="ml-input w-full" placeholder='["name", "company", "message"]' />
        </div>

        <div class="flex items-center gap-2">
          <input type="checkbox" name="is_active" class="w-4 h-4 text-ml-yellow rounded" checked />
          <span class="text-sm text-ml-text">Activa</span>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t">
          <a href="/admin/mensajeria/plantillas" class="ml-btn-outline">Cancelar</a>
          <button type="submit" class="ml-btn-primary">Crear plantilla</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    document.getElementById('template-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      data.is_active = data.is_active ? 1 : 0;
      try {
        data.variables = JSON.parse(formData.get('variables') || '[]');
      } catch {
        data.variables = [];
      }

      try {
        const res = await fetch('/api/admin/mensajeria/plantillas', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) {
          alert('Plantilla creada correctamente');
          location.href = '/admin/mensajeria/plantillas';
        } else {
          const err = await res.json();
          alert('Error: ' + (err.error || 'Error al crear'));
        }
      } catch {
        alert('Error de conexión');
      }
    });
  </script>
</BaseLayout>