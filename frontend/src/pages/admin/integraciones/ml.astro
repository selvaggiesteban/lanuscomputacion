---
import Layout from "../../../layouts/AdminLayout.astro";

const env = Astro.locals.runtime.env;
const status = Astro.url.searchParams.get("status");

function formatTs(value: string | null | undefined): string | null {
  if (!value) return null;
  try {
    const raw = String(value);
    const iso = raw.includes("T") ? raw : raw.replace(" ", "T") + "Z";
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return raw;
    return d.toLocaleString("es-AR", { dateStyle: "medium", timeStyle: "short" });
  } catch {
    return String(value);
  }
}

// Token de conexión (tabla puede no existir aún → estado "no configurado")
let tokenRow: any = null;
try {
  tokenRow = await env.DB.prepare("SELECT * FROM meli_tokens WHERE id=1").first();
} catch (e) {
  console.error("D1 Error (meli_tokens) en admin/integraciones/ml:", e);
  tokenRow = null;
}

const connected = !!(tokenRow && tokenRow.access_token);
const nickname: string | null = tokenRow?.nickname || null;
const tokenExpires = formatTs(tokenRow?.expires_at);
const lastSync = formatTs(tokenRow?.last_sync_at);

// Stats del catálogo
let totalProducts = 0;
try {
  const r = await env.DB.prepare("SELECT COUNT(*) AS c FROM products").first<{ c: number }>();
  totalProducts = r?.c ?? 0;
} catch (e) {
  console.error("D1 Error (products count) en admin/integraciones/ml:", e);
}

let syncedProducts = 0;
try {
  const r = await env.DB.prepare(
    "SELECT COUNT(*) AS c FROM products WHERE ml_item_id IS NOT NULL"
  ).first<{ c: number }>();
  syncedProducts = r?.c ?? 0;
} catch (e) {
  console.error("D1 Error (products ml_item_id count) en admin/integraciones/ml:", e);
}

const unsyncedProducts = Math.max(totalProducts - syncedProducts, 0);
const syncPct = totalProducts > 0 ? Math.round((syncedProducts / totalProducts) * 100) : 0;

// Eventos recientes (tabla puede no existir aún)
let events: any[] = [];
try {
  const { results } = await env.DB.prepare(
    "SELECT * FROM meli_events ORDER BY created_at DESC LIMIT 10"
  ).all();
  events = results || [];
} catch (e) {
  console.error("D1 Error (meli_events) en admin/integraciones/ml:", e);
  events = [];
}

function eventBadgeClass(statusValue: string | null | undefined): string {
  const s = String(statusValue || "").toLowerCase();
  if (s.includes("error") || s.includes("fail")) return "bg-red-100 text-red-700";
  if (s.includes("pend")) return "bg-yellow-100 text-yellow-700";
  return "bg-green-100 text-green-700";
}
---

<Layout title="Integración Mercado Libre | Admin - Lanús Computación">
  <div class="p-6 max-w-6xl mx-auto">
    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Mercado Libre</h1>
        <p class="text-gray-500">Gestión de canal de ventas y sincronización de catálogo</p>
      </div>
      <div class="flex gap-3">
        <button id="sync-all" class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition flex items-center gap-2 shadow-sm cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
          <span>🔄</span> Sincronizar ahora
        </button>
      </div>
    </div>

    {status === 'success' && (
      <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded mb-6 shadow-sm">
        <p class="font-bold">Cuenta conectada exitosamente</p>
        <p>Tu tienda ahora está vinculada con tu cuenta de vendedor de Mercado Libre.</p>
      </div>
    )}

    <div id="ml-action-status" class="hidden p-3 rounded-lg text-sm mb-6 shadow-sm"></div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
        <p class="text-sm text-gray-500 uppercase font-semibold">Productos Totales</p>
        <p class="text-3xl font-bold text-gray-800">{totalProducts}</p>
        <p class="text-xs text-gray-400 mt-1">En base de datos D1</p>
      </div>
      <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
        <p class="text-sm text-gray-500 uppercase font-semibold">Sincronizados</p>
        <p class="text-3xl font-bold text-indigo-600">{syncedProducts}</p>
        <p class="text-xs text-gray-400 mt-1">{syncPct}% del catálogo</p>
      </div>
      <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
        <p class="text-sm text-gray-500 uppercase font-semibold">Sin Publicar</p>
        <p class="text-3xl font-bold text-yellow-600">{unsyncedProducts}</p>
        <p class="text-xs text-gray-400 mt-1">Sin ID de Mercado Libre</p>
      </div>
      <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
        <p class="text-sm text-gray-500 uppercase font-semibold">Estado Conexión</p>
        <p id="stat-connection" class="text-lg font-bold text-gray-800 mt-2 flex items-center gap-2">
          <span class={`w-3 h-3 rounded-full inline-block ${connected ? "bg-green-500" : "bg-red-500"}`}></span>
          {connected ? (nickname ? `Conectado — ${nickname}` : "Conectado") : "No conectado"}
        </p>
        <p class="text-xs text-gray-400 mt-1">
          {totalProducts} productos · {syncedProducts} sincronizados · {unsyncedProducts} sin publicar
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Control Panel -->
      <div class="lg:col-span-1 space-y-6">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
          <h2 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <span>⚙️</span> Configuración de Cuenta
          </h2>
          <div class="space-y-3 mb-5">
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
              <span class="text-sm text-gray-700">Conexión</span>
              <span class={`text-xs px-2 py-1 rounded-full font-bold ${connected ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600"}`}>
                {connected ? (nickname ? `Conectado — ${nickname}` : "Conectado") : "No conectado"}
              </span>
            </div>
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
              <span class="text-sm text-gray-700">Última sincronización</span>
              <span class="text-xs font-bold text-gray-700">{lastSync ?? "Nunca"}</span>
            </div>
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
              <span class="text-sm text-gray-700">Token de acceso</span>
              <span class="text-xs font-bold text-gray-700">
                {connected ? (tokenExpires ? `Vence ${tokenExpires}` : "—") : "—"}
              </span>
            </div>
          </div>
          <div class="space-y-3">
            <a
              href="/api/meli/connect"
              class="block text-center bg-blue-600 text-white px-4 py-3 rounded-lg hover:bg-blue-700 transition font-medium shadow-sm"
            >
              Conectar cuenta Mercado Libre
            </a>
            <button
              id="register-hook"
              class="w-full bg-white border border-gray-300 text-gray-800 px-4 py-3 rounded-lg hover:bg-gray-50 transition font-medium shadow-sm cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Registrar webhook
            </button>
            <p class="text-xs text-gray-400 text-center">
              Conectar te redirige al login oficial de Mercado Libre; al autorizar, la cuenta queda vinculada.
            </p>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
          <h2 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <span>💡</span> Cómo configurar la integración
          </h2>
          <ol class="list-decimal list-inside space-y-2 text-sm text-gray-600">
            <li>Hacé click en <strong>Conectar cuenta Mercado Libre</strong> y autorizá la app en el sitio de ML.</li>
            <li>Al volver, el estado debería mostrar <strong>Conectado</strong> con tu nickname de vendedor.</li>
            <li>Registra el webhook con el botón <strong>Registrar webhook</strong> para recibir las notificaciones de ventas.</li>
            <li>Usá <strong>Sincronizar ahora</strong> para publicar o actualizar el catálogo en ML.</li>
          </ol>
          <p class="text-xs text-gray-500 mt-4 p-3 bg-yellow-50 border-l-4 border-yellow-400 rounded">
            Los secretos de la aplicación (Client ID y Client Secret) se configuran como variables de entorno en Cloudflare Pages; nunca se guardan en el código ni en esta pantalla.
          </p>
        </div>
      </div>

      <!-- Events Log -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="p-6 border-b border-gray-100 flex justify-between items-center">
            <h2 class="text-lg font-semibold flex items-center gap-2">
              <span>📜</span> Actividad Reciente
            </h2>
            <button id="refresh-logs" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium cursor-pointer">Actualizar</button>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-gray-50 text-gray-500 uppercase text-xs font-semibold">
                <tr>
                  <th class="px-6 py-3">Fecha</th>
                  <th class="px-6 py-3">Tipo</th>
                  <th class="px-6 py-3">Estado</th>
                  <th class="px-6 py-3">Mensaje</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {events.length === 0 && (
                  <tr>
                    <td colspan="4" class="px-6 py-10 text-center text-gray-400 italic">Sin eventos todavía</td>
                  </tr>
                )}
                {events.map((e) => (
                  <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-4 text-gray-500 whitespace-nowrap">{formatTs(e.created_at) ?? "—"}</td>
                    <td class="px-6 py-4">
                      <span class="px-2 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700">
                        {(e.event_type || "—").toUpperCase()}
                      </span>
                    </td>
                    <td class="px-6 py-4">
                      <span class={`px-2 py-1 rounded-full text-xs font-bold ${eventBadgeClass(e.status)}`}>
                        {e.status || "—"}
                      </span>
                    </td>
                    <td class="px-6 py-4 text-gray-600">{e.message || "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function showStatus(text: string, kind: "ok" | "error" | "info") {
      const el = document.getElementById("ml-action-status");
      if (!el) return;
      el.textContent = text;
      const colors =
        kind === "ok"
          ? "bg-green-50 text-green-700 border-l-4 border-green-500"
          : kind === "error"
            ? "bg-red-50 text-red-700 border-l-4 border-red-500"
            : "bg-gray-100 text-gray-700 border-l-4 border-gray-400";
      el.className = `p-3 rounded-lg text-sm mb-6 shadow-sm ${colors}`;
    }

    // Registrar webhook
    const hookBtn = document.getElementById("register-hook") as HTMLButtonElement | null;
    hookBtn?.addEventListener("click", async () => {
      if (!hookBtn) return;
      hookBtn.disabled = true;
      showStatus("Registrando webhook…", "info");
      try {
        const res = await fetch("/api/meli/hooks", { method: "POST", credentials: "same-origin" });
        let data: any = null;
        try {
          data = await res.json();
        } catch {}
        if (res.ok && data?.registered) {
          showStatus("Webhook registrado correctamente.", "ok");
        } else {
          const detail = data?.error ? `: ${data.error}` : ` (HTTP ${res.status})`;
          showStatus(`No se pudo registrar el webhook${detail}`, "error");
        }
      } catch {
        showStatus("Error de red al registrar el webhook.", "error");
      } finally {
        hookBtn.disabled = false;
      }
    });

    // Sincronizar ahora
    const syncBtn = document.getElementById("sync-all") as HTMLButtonElement | null;
    syncBtn?.addEventListener("click", async () => {
      if (!syncBtn) return;
      syncBtn.disabled = true;
      showStatus("Sincronizando catálogo…", "info");
      try {
        const res = await fetch("/api/meli/sync", { method: "POST", credentials: "same-origin" });
        let data: any = null;
        try {
          data = await res.json();
        } catch {}
        if (res.ok) {
          const created = data?.created ?? 0;
          const updated = data?.updated ?? 0;
          const failed = data?.failed ?? 0;
          const skipped = data?.skipped ?? 0;
          showStatus(`Sincronización finalizada: ${created} creados, ${updated} actualizados, ${skipped} sin cambios, ${failed} fallidos.`, failed > 0 ? "error" : "ok");
        } else {
          const detail = data?.error ? `: ${data.error}` : ` (HTTP ${res.status})`;
          showStatus(`La sincronización falló${detail}`, "error");
        }
      } catch {
        showStatus("Error de red al sincronizar.", "error");
      } finally {
        syncBtn.disabled = false;
      }
    });

    document.getElementById("refresh-logs")?.addEventListener("click", () => {
      window.location.reload();
    });
  </script>
</Layout>
