---
import BaseLayout from '../../layouts/BaseLayout.astro';

const db = Astro.locals.runtime.env.DB;

const { results: coupons } = await db.prepare(
  "SELECT * FROM coupons ORDER BY created_at DESC"
).all();

const { results: categories } = await db.prepare(
  "SELECT id, name FROM categories WHERE is_active = 1 AND parent_id IS NOT NULL ORDER BY name"
).all<{ id: string; name: string }>();
---

<BaseLayout title="Cupones | Admin - Lanús Computación">
  <div class="ml-container py-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-semibold text-ml-text">Gestión de Cupones</h1>
      <div class="flex gap-3">
        <button id="btn-new-coupon" class="ml-btn-primary text-sm">+ Nuevo Cupón</button>
        <a href="/admin" class="text-sm text-ml-blue hover:underline">← Volver</a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <div class="bg-white rounded shadow-card p-4">
        <p class="text-2xl font-bold text-purple-600">{coupons.filter((c: any) => c.is_active).length}</p>
        <p class="text-xs text-ml-text-muted">Cupones Activos</p>
      </div>
      <div class="bg-white rounded shadow-card p-4">
        <p class="text-2xl font-bold text-ml-text">{coupons.length}</p>
        <p class="text-xs text-ml-text-muted">Total Cupones</p>
      </div>
      <div class="bg-white rounded shadow-card p-4">
        <p class="text-2xl font-bold text-green-600">{coupons.reduce((sum: number, c: any) => sum + (c.used_count || 0), 0)}</p>
        <p class="text-xs text-ml-text-muted">Usos Totales</p>
      </div>
    </div>

    <div class="bg-white rounded shadow-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 border-b">
            <tr>
              <th class="text-left p-3 font-medium text-ml-text">Código</th>
              <th class="text-center p-3 font-medium text-ml-text">Tipo</th>
              <th class="text-right p-3 font-medium text-ml-text">Valor</th>
              <th class="text-right p-3 font-medium text-ml-text">Compra mín.</th>
              <th class="text-center p-3 font-medium text-ml-text">Usos</th>
              <th class="text-left p-3 font-medium text-ml-text">Aplica a</th>
              <th class="text-center p-3 font-medium text-ml-text">Estado</th>
              <th class="text-center p-3 font-medium text-ml-text">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y">
            {coupons.length > 0 ? coupons.map((c: any) => {
              const isExpired = c.end_date && new Date(c.end_date) < new Date();
              const isNotStarted = c.start_date && new Date(c.start_date) > new Date();
              const statusLabel = !c.is_active ? 'Inactivo' : isExpired ? 'Vencido' : isNotStarted ? 'Programado' : 'Activo';
              const statusColor = !c.is_active ? 'bg-gray-100 text-gray-800' : isExpired ? 'bg-red-100 text-red-800' : isNotStarted ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800';
              return (
                <tr class="hover:bg-gray-50">
                  <td class="p-3">
                    <p class="font-mono font-bold text-ml-text">{c.code}</p>
                  </td>
                  <td class="p-3 text-center">
                    <span class="text-xs text-ml-text-secondary">{c.type === 'percentage' ? 'Porcentaje' : 'Monto Fijo'}</span>
                  </td>
                  <td class="p-3 text-right font-medium text-ml-text">
                    {c.type === 'percentage' ? `${c.value}%` : `$${c.value.toLocaleString('es-AR')}`}
                  </td>
                  <td class="p-3 text-right text-xs text-ml-text-secondary">
                    {c.min_purchase > 0 ? `$${c.min_purchase.toLocaleString('es-AR')}` : '—'}
                  </td>
                  <td class="p-3 text-center text-xs text-ml-text-secondary">
                    {c.used_count || 0}{c.max_uses ? ` / ${c.max_uses}` : ''}
                  </td>
                  <td class="p-3 text-xs text-ml-text-secondary">
                    {c.applies_to === 'all' ? 'Todos' : c.applies_to === 'category' ? `Categoría` : `Producto`}
                  </td>
                  <td class="p-3 text-center">
                    <span class={`px-2 py-1 rounded text-xs font-medium ${statusColor}`}>{statusLabel}</span>
                  </td>
                  <td class="p-3 text-center">
                    <button class="edit-coupon text-ml-blue text-xs hover:underline mr-2" data-id={c.id}>Editar</button>
                    <button class="delete-coupon text-red-500 text-xs hover:underline" data-id={c.id}>Eliminar</button>
                  </td>
                </tr>
              );
            }) : (
              <tr>
                <td colspan="8" class="p-8 text-center text-ml-text-muted">
                  No hay cupones creados. Creá uno para empezar.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="modal-overlay" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <div class="p-4 border-b flex items-center justify-between">
        <h2 id="modal-title" class="font-medium text-ml-text">Nuevo Cupón</h2>
        <button id="modal-close" class="text-ml-text-muted hover:text-ml-text text-xl">&times;</button>
      </div>
      <form id="coupon-form" class="p-4 space-y-4">
        <input type="hidden" name="id" id="form-id" />
        <div>
          <label class="block text-xs text-ml-text-muted mb-1">Código del cupón</label>
          <input type="text" name="code" id="form-code" class="ml-input w-full font-mono uppercase" placeholder="Ej: BLACKFRIDAY20" required />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Tipo</label>
            <select name="type" id="form-type" class="ml-input w-full">
              <option value="percentage">Porcentaje (%)</option>
              <option value="fixed">Monto Fijo ($)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Valor</label>
            <input type="number" name="value" id="form-value" class="ml-input w-full" step="0.01" required />
          </div>
        </div>
        <div>
          <label class="block text-xs text-ml-text-muted mb-1">Compra mínima ($)</label>
          <input type="number" name="min_purchase" id="form-min-purchase" class="ml-input w-full" value="0" step="0.01" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Máx. usos (0 = ilimitado)</label>
            <input type="number" name="max_uses" id="form-max-uses" class="ml-input w-full" value="0" />
          </div>
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Aplica a</label>
            <select name="applies_to" id="form-applies-to" class="ml-input w-full">
              <option value="all">Todos los productos</option>
              <option value="category">Categoría específica</option>
              <option value="product">Producto específico</option>
            </select>
          </div>
        </div>
        <div id="target-section" class="hidden">
          <label class="block text-xs text-ml-text-muted mb-1">ID del objetivo</label>
          <select name="target_id" id="form-target-id" class="ml-input w-full">
            <option value="">Seleccionar categoría...</option>
            {categories.map((c: any) => <option value={c.id}>{c.name}</option>)}
          </select>
          <p class="text-xs text-ml-text-muted mt-1">Para producto específico, ingresá el ID del producto</p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Fecha inicio (opcional)</label>
            <input type="datetime-local" name="start_date" id="form-start-date" class="ml-input w-full" />
          </div>
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Fecha fin (opcional)</label>
            <input type="datetime-local" name="end_date" id="form-end-date" class="ml-input w-full" />
          </div>
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" name="is_active" id="form-active" checked class="w-4 h-4 text-ml-blue rounded" />
          <label for="form-active" class="text-sm text-ml-text">Activo</label>
        </div>
        <div class="flex gap-3 justify-end">
          <button type="button" id="modal-cancel" class="ml-btn-secondary px-4">Cancelar</button>
          <button type="submit" class="ml-btn-primary px-6">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const overlay = document.getElementById('modal-overlay')!;
  const form = document.getElementById('coupon-form') as HTMLFormElement;
  const modalTitle = document.getElementById('modal-title')!;
  const appliesTo = document.getElementById('form-applies-to') as HTMLSelectElement;
  const targetSection = document.getElementById('target-section')!;

  appliesTo?.addEventListener('change', () => {
    targetSection.classList.toggle('hidden', appliesTo.value === 'all');
  });

  function openModal(coupon?: any) {
    if (coupon) {
      modalTitle.textContent = 'Editar Cupón';
      (document.getElementById('form-id') as HTMLInputElement).value = coupon.id;
      (document.getElementById('form-code') as HTMLInputElement).value = coupon.code || '';
      (document.getElementById('form-type') as HTMLSelectElement).value = coupon.type || 'percentage';
      (document.getElementById('form-value') as HTMLInputElement).value = coupon.value || '';
      (document.getElementById('form-min-purchase') as HTMLInputElement).value = coupon.min_purchase || 0;
      (document.getElementById('form-max-uses') as HTMLInputElement).value = coupon.max_uses || 0;
      (document.getElementById('form-applies-to') as HTMLSelectElement).value = coupon.applies_to || 'all';
      (document.getElementById('form-target-id') as HTMLSelectElement).value = coupon.target_id || '';
      (document.getElementById('form-start-date') as HTMLInputElement).value = coupon.start_date ? coupon.start_date.slice(0, 16) : '';
      (document.getElementById('form-end-date') as HTMLInputElement).value = coupon.end_date ? coupon.end_date.slice(0, 16) : '';
      (document.getElementById('form-active') as HTMLInputElement).checked = coupon.is_active === 1;
      targetSection.classList.toggle('hidden', coupon.applies_to === 'all');
    } else {
      modalTitle.textContent = 'Nuevo Cupón';
      form.reset();
      (document.getElementById('form-id') as HTMLInputElement).value = '';
      targetSection.classList.add('hidden');
    }
    overlay.classList.remove('hidden');
  }

  document.getElementById('btn-new-coupon')?.addEventListener('click', () => openModal());
  document.getElementById('modal-close')?.addEventListener('click', () => overlay.classList.add('hidden'));
  document.getElementById('modal-cancel')?.addEventListener('click', () => overlay.classList.add('hidden'));
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.add('hidden'); });

  document.querySelectorAll('.edit-coupon').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/admin/coupons`);
      const coupons = await res.json();
      const coupon = coupons.find((c: any) => c.id === id);
      if (coupon) openModal(coupon);
    });
  });

  document.querySelectorAll('.delete-coupon').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('¿Eliminar este cupón?')) return;
      const id = (btn as HTMLElement).dataset.id;
      await fetch('/api/admin/coupons', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id }),
      });
      location.reload();
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const id = formData.get('id') || crypto.randomUUID();
    const maxUses = Number(formData.get('max_uses'));
    const body: any = {
      id,
      code: formData.get('code'),
      type: formData.get('type'),
      value: Number(formData.get('value')),
      min_purchase: Number(formData.get('min_purchase')) || 0,
      max_uses: maxUses > 0 ? maxUses : null,
      applies_to: formData.get('applies_to'),
      target_id: formData.get('target_id') || null,
      start_date: formData.get('start_date') || null,
      end_date: formData.get('end_date') || null,
      is_active: (document.getElementById('form-active') as HTMLInputElement).checked,
    };

    await fetch('/api/admin/coupons', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    overlay.classList.add('hidden');
    location.reload();
  });
</script>
