---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllNfcCards } from '../../lib/d1';

const db = Astro.locals.runtime.env.DB;
const cards = await getAllNfcCards(db);
const nextNumber = Math.max(0, ...cards.map(c => c.card_number)) + 1;
---

<BaseLayout title="Nueva Tarjeta NFC | Lanús Computación">
  <div class="ml-container py-6">
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-xl font-semibold text-ml-text">Nueva Tarjeta NFC</h1>
          <p class="text-sm text-ml-text-muted">Próximo número: #{nextNumber.toString().padStart(2, '0')}</p>
        </div>
        <a href="/admin/nfc" class="text-sm ml-link">← Volver</a>
      </div>

      <form id="nfc-form" class="bg-white rounded shadow-card p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Número de tarjeta (1-20)</label>
            <input type="number" name="card_number" min="1" max="20" value="{nextNumber}" class="ml-input w-full" required />
          </div>
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Slug (p/XX)</label>
            <input type="text" name="slug" value="p/{nextNumber.toString().padStart(2, '0')}" class="ml-input w-full" required pattern="p/\d{2}" />
          </div>
        </div>

        <div>
          <label class="block text-xs text-ml-text-muted mb-1">Título *</label>
          <input type="text" name="title" class="ml-input w-full" required placeholder="Ej: Ofertas Especiales" />
        </div>

        <div>
          <label class="block text-xs text-ml-text-muted mb-1">Descripción</label>
          <textarea name="description" class="ml-input w-full" rows="3" placeholder="Descripción corta para el panel admin"></textarea>
        </div>

        <div>
          <label class="block text-xs text-ml-text-muted mb-1">URL Destino *</label>
          <input type="text" name="target_url" class="ml-input w-full" required placeholder="https://... o /ruta" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Tipo destino *</label>
            <select name="target_type" class="ml-input w-full" required>
              <option value="page">Page</option>
              <option value="product">Product</option>
              <option value="category">Category</option>
              <option value="contact">Contact</option>
              <option value="custom">Custom</option>
            </select>
          </div>
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">ID destino (opcional)</label>
            <input type="text" name="target_id" class="ml-input w-full" placeholder="product_id, category_id, etc." />
          </div>
          <div class="flex items-end">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="is_active" class="w-4 h-4 text-ml-yellow rounded" checked />
              <span class="text-sm text-ml-text">Activa</span>
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Color fondo</label>
            <input type="color" name="background_color" value="#1a1a2e" class="ml-input w-full h-10 p-1" />
          </div>
          <div>
            <label class="block text-xs text-ml-text-muted mb-1">Color texto</label>
            <input type="color" name="text_color" value="#ffffff" class="ml-input w-full h-10 p-1" />
          </div>
        </div>

        <div>
          <label class="block text-xs text-ml-text-muted mb-1">Icono (emoji)</label>
          <input type="text" name="icon" class="ml-input w-full" maxlength="2" placeholder="📦" />
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t">
          <a href="/admin/nfc" class="ml-btn-outline">Cancelar</a>
          <button type="submit" class="ml-btn-primary">Crear tarjeta</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    document.getElementById('nfc-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      data.is_active = data.is_active ? 1 : 0;
      data.card_number = Number(data.card_number);
      data.id = `nfc_${data.card_number.toString().padStart(2, '0')}`;

      try {
        const res = await fetch('/api/admin/nfc', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) {
          alert('Tarjeta creada correctamente');
          location.href = '/admin/nfc';
        } else {
          const err = await res.json();
          alert('Error: ' + (err.error || 'Error al crear'));
        }
      } catch {
        alert('Error de conexión');
      }
    });
  </script>
</BaseLayout>