---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Iniciar sesión | Lanús Computación">
  <div class="min-h-dvh lg:grid lg:grid-cols-2">
    <!-- Brand panel (desktop) -->
    <aside class="hidden lg:flex flex-col justify-between bg-[#0f172a] p-10 xl:p-14 text-white">
      <a href="/" class="inline-flex items-center gap-3 group">
        <span class="bg-white rounded-xl p-2 shadow-lg">
          <img src="/logo.png" alt="" width="40" height="40" class="w-10 h-10 object-contain" />
        </span>
        <span class="text-lg font-bold tracking-tight group-hover:opacity-90">Lanús Computación</span>
      </a>

      <div class="max-w-md">
        <span class="inline-block bg-ml-yellow text-[#0f172a] text-xs font-bold px-2.5 py-1 rounded-full mb-6">
          Mayorista &amp; Minorista
        </span>
        <h2 class="text-3xl xl:text-4xl font-bold leading-tight mb-4">
          Tecnología para tu casa, tu negocio y tu estudio
        </h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          Ingresá para ver tus precios, hacer seguimiento de tus compras y acceder a las mejores
          ofertas del día.
        </p>
        <ul class="mt-8 space-y-3 text-sm text-slate-300">
          <li class="flex items-center gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-ml-yellow"></span> Envíos 24/48 hs a todo el país
          </li>
          <li class="flex items-center gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-ml-yellow"></span> Garantía oficial y soporte experto
          </li>
          <li class="flex items-center gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-ml-yellow"></span> Hasta 12 cuotas sin interés
          </li>
        </ul>
      </div>

      <p class="text-xs text-slate-500">lanuscomputacion.com</p>
    </aside>

    <!-- Form side -->
    <main class="flex min-h-dvh items-center justify-center px-5 py-10 sm:px-8">
      <div class="w-full max-w-md">
        <a href="/" class="lg:hidden mb-8 flex justify-center">
          <span class="bg-white rounded-xl p-3 shadow-card border border-ml-border">
            <img src="/logo.png" alt="Lanús Computación" width="56" height="56" class="w-14 h-14 object-contain" />
          </span>
        </a>

        <div class="bg-white rounded-2xl shadow-card border border-ml-border p-7 sm:p-9">
          <div class="text-center mb-6">
            <h1 class="text-xl font-semibold text-ml-text">¡Hola!</h1>
            <p class="text-sm text-ml-text-secondary mt-1">Ingresá tu email y contraseña</p>
          </div>

          <div id="success-message" class="hidden mb-4 p-3 bg-green-50 border border-green-200 rounded text-sm text-green-700"></div>
          <div id="error-message" class="hidden mb-4 p-3 bg-red-50 border border-red-200 rounded text-sm text-red-700"></div>

          <form id="login-form" class="space-y-4">
            <div>
              <input
                type="email"
                name="email"
                placeholder="Correo electrónico"
                class="ml-input w-full h-12"
                required
              />
            </div>
            <div>
              <input
                type="password"
                name="password"
                placeholder="Contraseña"
                class="ml-input w-full h-12"
                required
              />
            </div>

            <button type="submit" class="ml-btn-primary w-full h-12 text-base">
              Continuar
            </button>
          </form>

          <p class="text-center mt-3 text-xs">
            <a href="/olvidaste-contrasena" class="ml-link">¿Olvidaste tu contraseña?</a>
          </p>

          <div class="my-6 flex items-center gap-3 text-sm text-ml-text-muted">
            <div class="flex-1 h-px bg-ml-border" />
            <span>o</span>
            <div class="flex-1 h-px bg-ml-border" />
          </div>

          <!-- Social Login -->
          <div class="space-y-3">
            <button id="google-login" class="w-full h-12 flex items-center justify-center gap-3 border border-ml-border rounded hover:bg-gray-50 transition-colors text-sm font-medium">
              <img src="/google-favicon-2025.svg" alt="" width="20" height="20" class="w-5 h-5" />
              Continuar con Google
            </button>
          </div>

          <p class="text-center mt-6 text-xs text-ml-text-muted">
            ¿No tenés cuenta?
            <a href="/register" class="ml-link"> Registrate</a>
          </p>

          <p class="text-center mt-2 text-xs text-ml-text-muted">
            Al continuar, aceptás los
            <a href="#" class="ml-link"> Términos y Condiciones</a> y la
            <a href="#" class="ml-link"> Política de Privacidad</a>
          </p>
        </div>

        <p class="text-center mt-6 text-sm">
          <a href="/" class="ml-link">← Volver a la tienda</a>
        </p>
      </div>
    </main>
  </div>
</AuthLayout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorDiv = document.getElementById('error-message')!;
  const googleBtn = document.getElementById('google-login')!;

  // Show error from URL params (e.g., ?error=google_cancelled)
  const params = new URLSearchParams(window.location.search);
  const errorParam = params.get('error');
  if (errorParam) {
    if (errorParam === 'reset_success') {
      const successDiv = document.getElementById('success-message');
      if (successDiv) {
        successDiv.textContent = 'Contraseña actualizada. Iniciá sesión.';
        successDiv.classList.remove('hidden');
      }
      window.history.replaceState({}, '', '/login');
    } else {
      const messages: Record<string, string> = {
        google_cancelled: 'Inicio de sesión con Google cancelado.',
        google_token_failed: 'Error al autenticar con Google.',
        google_failed: 'Error al conectar con Google.',
      };
      errorDiv.textContent = messages[errorParam] || 'Error al iniciar sesión con Google';
      errorDiv.classList.remove('hidden');
      window.history.replaceState({}, '', '/login');
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.classList.add('hidden');

    const formData = new FormData(form);
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });

      const data = await res.json();

      if (!res.ok) {
        errorDiv.textContent = data.error || 'Error al iniciar sesión';
        errorDiv.classList.remove('hidden');
        return;
      }

      window.location.href = data.user?.isAdmin ? '/admin' : '/';
    } catch (err) {
      errorDiv.textContent = 'Error de conexión';
      errorDiv.classList.remove('hidden');
    }
  });

  googleBtn?.addEventListener('click', () => {
    window.location.href = '/api/auth/google';
  });
</script>
