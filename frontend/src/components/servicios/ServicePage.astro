---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../ui/Breadcrumb.astro';

export interface FAQ {
  question: string;
  answer: string;
}

export interface Benefit {
  icon: string;
  title: string;
  desc: string;
}

export interface Step {
  title: string;
  desc: string;
}

export interface Props {
  title: string;
  description: string;
  slug: string;
  heroTitle: string;
  heroSubtitle: string;
  icon: string;
  benefits: Benefit[];
  steps: Step[];
  faqs: FAQ[];
  ctaText?: string;
  whatsappText?: string;
}

const {
  title,
  description,
  slug,
  heroTitle,
  heroSubtitle,
  icon,
  benefits,
  steps,
  faqs,
  ctaText = 'Solicitá tu presupuesto sin costo',
  whatsappText = 'Hola, quiero solicitar un presupuesto',
} = Astro.props;

const canonical = `https://lanuscomputacion.com/servicios/${slug}`;
const whatsappUrl = `https://wa.me/5491153323937?text=${encodeURIComponent(whatsappText)}`;

const jsonLdService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: heroTitle,
  description: description,
  provider: {
    '@type': 'Organization',
    name: 'Lanús Computación',
    url: 'https://lanuscomputacion.com',
  },
  areaServed: {
    '@type': 'City',
    name: 'Lanús, Buenos Aires, Argentina',
  },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'ARS',
  },
};

const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<BaseLayout {title} {description}>
  <link rel="canonical" href={canonical} slot="head" />

  <!-- JSON-LD Service -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdService)} />
  <!-- JSON-LD FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

  <div class="ml-container py-4">
    <Breadcrumb items={[
      { label: 'Inicio', href: '/' },
      { label: 'Servicios', href: '/servicios' },
      { label: heroTitle },
    ]} />
  </div>

  <!-- Hero -->
  <section class="ml-container pb-6">
    <div class="bg-gradient-to-r from-b2b-purple-light to-purple-50 rounded-lg p-6 md:p-8">
      <div class="flex items-start gap-4">
        <div class="w-14 h-14 bg-b2b-purple rounded flex items-center justify-center flex-shrink-0">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
        </div>
        <div>
          <h1 class="text-2xl md:text-3xl font-bold text-ml-text mb-2">{heroTitle}</h1>
          <p class="text-ml-text-secondary text-base md:text-lg">{heroSubtitle}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="ml-container py-6">
    <h2 class="text-xl font-semibold text-ml-text mb-6">Qué incluye el servicio</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {benefits.map((b) => (
        <div class="bg-white rounded shadow-card p-4">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-ml-green-bg rounded flex items-center justify-center flex-shrink-0">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00a650" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={b.icon} />
            </div>
            <div>
              <h3 class="text-sm font-semibold text-ml-text">{b.title}</h3>
              <p class="text-xs text-ml-text-muted mt-1">{b.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Process Steps -->
  <section class="ml-container py-6">
    <h2 class="text-xl font-semibold text-ml-text mb-6">Cómo trabajamos</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {steps.map((step, i) => (
        <div class="relative bg-white rounded shadow-card p-4">
          <div class="absolute -top-3 -left-3 w-8 h-8 bg-b2b-purple text-white rounded-full flex items-center justify-center text-sm font-bold">
            {i + 1}
          </div>
          <h3 class="text-sm font-semibold text-ml-text mt-2">{step.title}</h3>
          <p class="text-xs text-ml-text-muted mt-1">{step.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Custom content slot -->
  <slot />

  <!-- FAQ -->
  <section class="ml-container py-6">
    <h2 class="text-xl font-semibold text-ml-text mb-6 text-center">Preguntas frecuentes</h2>
    <div class="space-y-3 max-w-3xl mx-auto">
      {faqs.map((faq) => (
        <details class="bg-white rounded shadow-card group">
          <summary class="flex items-center justify-between p-4 cursor-pointer list-none text-sm font-medium text-ml-text">
            {faq.question}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="transition-transform group-open:rotate-180 flex-shrink-0">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <div class="px-4 pb-4 text-sm text-ml-text-secondary">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="ml-container py-6 pb-12">
    <div class="bg-b2b-purple text-white rounded-lg p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <h2 class="text-xl md:text-2xl font-bold mb-1">{ctaText}</h2>
        <p class="opacity-90 text-sm">Respondemos a la brevedad. Sin compromiso.</p>
      </div>
      <div class="flex gap-3 flex-shrink-0">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="bg-white text-b2b-purple font-bold px-6 py-3 rounded hover:bg-purple-50 transition-colors whitespace-nowrap">
          WhatsApp
        </a>
        <a href="/servicios/contacto" class="bg-b2b-purple-light text-white font-bold px-6 py-3 rounded hover:bg-purple-400 transition-colors whitespace-nowrap border border-purple-300">
          Formulario
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
