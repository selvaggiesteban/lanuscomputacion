---
import ProductCard from './ProductCard.astro';
import type { Product } from './ProductCard.astro';
import { getActiveB2bRules } from '../../lib/d1';
import { getB2bPrice } from '../../lib/b2b';

export interface Props {
  products: Product[];
  columns?: 2 | 3 | 4 | 5;
}

const { products, columns = 4 } = Astro.props;

// Public wholesale price: computed once per page from DB rules. The value is
// identical for every visitor, so the edge cache stays valid. Purchases are
// gated server-side in /api/checkout (approved B2B accounts only).
let items = products;
if (products.length > 0) {
  try {
    const db = (Astro.locals as any)?.runtime?.env?.DB;
    if (db) {
      const rules = await getActiveB2bRules(db);
      if (rules.length > 0) {
        items = products.map((p) => {
          const info = getB2bPrice(
            rules,
            p.categoryName,
            p.originalPrice ?? p.price,
            p.price
          );
          return info
            ? { ...p, b2bPrice: info.price, b2bMinQty: info.minQuantity }
            : p;
        });
      }
    }
  } catch {
    // Wholesale price is informational — render cards without it.
  }
}

const gridCols = {
  2: 'grid-cols-2 md:grid-cols-2',
  3: 'grid-cols-2 md:grid-cols-3',
  4: 'grid-cols-2 md:grid-cols-3 lg:grid-cols-4',
  5: 'grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5',
};
---

{items.length > 0 ? (
  <div class={`grid ${gridCols[columns]} gap-4`}>
    {items.map(product => (
      <ProductCard product={product} />
    ))}
  </div>
) : (
  <div class="col-span-full text-center py-16 text-ml-text-muted">
    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="mx-auto mb-4 opacity-30">
      <circle cx="11" cy="11" r="8" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <p class="text-lg">No encontramos productos</p>
    <p class="text-sm mt-1">Intentá con otros filtros o categorías</p>
  </div>
)}
